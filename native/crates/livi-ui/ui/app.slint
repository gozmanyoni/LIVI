import "fonts/Roboto-300.ttf";
import "fonts/Roboto-400.ttf";
import "fonts/Roboto-500.ttf";
import "fonts/Roboto-700.ttf";
import { Theme, Ui } from "theme.slint";
import { Focus, FocusZone } from "focus.slint";
import { Nav, Page, PhoneState, TabData } from "nav.slint";
import { MediaPage, MediaText, Press, DabState, StationData } from "media.slint";
import { ProjectionPage, TouchPhase } from "projection.slint";
import { SettingsView, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData } from "settings/view.slint";
import { Dashboard, DashState, GaugeData, CapData, TrailData, LabelData } from "dashboard.slint";
import { LevelOverlay, PhoneOverlay, OverlayState } from "overlays.slint";
import { MaskData } from "mask.slint";
import { HomePage, MapViewport } from "home.slint";

export { MapViewport, Theme, Focus, FocusZone, Page, PhoneState, TabData, TouchPhase, SettingsState, ScreenKind, RowData, RowKind, PickData, KnobData, MediaText, Press, DabState, StationData, DashState, GaugeData, CapData, TrailData, LabelData, OverlayState, MaskData }

export component AppWindow inherits Window {
    in-out property <Page> page: Page.home;
    in-out property <int> home-page: 0;
    out property <bool> home-moving: home.moving;
    out property <length> home-offset: home.visual-offset;
    in property <bool> home-media-enabled: true;
    callback home-open(int);
    in property <bool> map-preview-ready;
    in property <MapViewport> map-preview-confirmed;
    in property <bool> map-preview-enabled: true;
    out property <MapViewport> map-viewport: {
        shown: home.map-viewport.shown,
        x: home.map-viewport.x,
        y: root.height > 0px ? (root.chrome-height + home.map-viewport.y * home.height) / root.height : 0,
        width: home.map-viewport.width,
        height: root.height > 0px ? home.map-viewport.height * home.height / root.height : 0,
    };
    callback map-viewport-changed();
    changed map-viewport => { root.map-viewport-changed(); }
    in property <[TabData]> tabs;
    in property <image> projection-icon;
    in property <PhoneState> phone;
    in property <string> clock;
    in property <string> calendar-day;
    in property <string> calendar-month;
    in property <string> calendar-year;
    in property <bool> right-hand;
    in property <int> stream-width: 1280;
    in property <int> stream-height: 720;
    in property <MaskData> main-mask;
    in property <bool> camera-found;
    in property <string> no-camera: "No camera found";
    in property <string> status;

    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;

    callback page-chosen(Page);
    callback touch(TouchPhase, float, float);
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    property <bool> nav-hidden: root.page == Page.projection && root.phone == PhoneState.streaming;
    property <bool> nav-asleep;
    property <bool> drawer-open;
    property <bool> drawer-visible: !root.nav-hidden && (root.drawer-open || Focus.zone == FocusZone.nav);

    public function wake-nav() {
        root.nav-asleep = false;
        DashState.dots-shown = true;
        if (root.page == Page.telemetry) {
            nav-timer.start();
            nav-timer.restart();
        } else {
            nav-timer.stop();
        }
    }

    nav-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.stop();
            root.nav-asleep = true;
            DashState.dots-shown = false;
        }
    }
    changed page => {
        root.drawer-open = false;
        root.wake-nav();
    }

    title: "OpenNBT";
    default-font-family: "Roboto";
    preferred-width: 1600px;
    preferred-height: 600px;
    min-width: 320px;
    min-height: 200px;
    background: transparent;

    changed height => { Ui.height = self.height; }
    changed width => { Ui.width = self.width; }
    init => {
        Ui.height = self.height;
        Ui.width = self.width;
        root.wake-nav();
    }

    if root.page == Page.telemetry: Dashboard {
        y: root.chrome-height;
        width: root.width;
        height: root.height - root.chrome-height;
    }

    property <length> chrome-height: root.nav-hidden ? 0px : 62px * Ui.nbt-scale;
    if !root.nav-hidden: Rectangle {
        y: 0px;
        height: root.chrome-height;
        background: Theme.dark ? @linear-gradient(180deg, #18181d, #08080d 58%, #030306) : @linear-gradient(180deg, #eeeeee, #d4d4d8);
        Image {
            x: 24px * Ui.nbt-scale;
            y: 7px * Ui.nbt-scale;
            width: 46px * Ui.nbt-scale;
            height: self.width;
            source: @image-url("assets/bmw-roundel.svg");
        }
        TouchArea {
            x: 12px * Ui.nbt-scale;
            width: 88px * Ui.nbt-scale;
            clicked => {
                if (root.page != Page.home) {
                    root.page = Page.home;
                    root.page-chosen(Page.home);
                    Focus.zone = FocusZone.none;
                } else {
                    root.drawer-open = !root.drawer-visible;
                    Focus.zone = root.drawer-open ? FocusZone.nav : FocusZone.none;
                }
            }
        }
        if root.width > 650px: Text {
            x: 92px * Ui.nbt-scale;
            text: "M3";
            color: Theme.text-secondary;
            font-size: 24px * Ui.nbt-scale;
            font-weight: 400;
            vertical-alignment: center;
        }
        Text {
            x: root.width - 500px * Ui.nbt-scale;
            width: 260px * Ui.nbt-scale;
            text: root.app != "" ? root.app : "OpenNBT";
            color: Theme.text-secondary;
            font-size: 25px * Ui.nbt-scale;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.phone != PhoneState.none: Image {
            x: root.width - 208px * Ui.nbt-scale;
            width: 26px * Ui.nbt-scale;
            height: self.width;
            source: @image-url("icons/BluetoothOutlined.svg");
            colorize: Theme.text-secondary;
        }
        Text {
            x: root.width - 162px * Ui.nbt-scale;
            width: 128px * Ui.nbt-scale;
            text: root.clock;
            color: Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 29px * Ui.nbt-scale;
        }
    }
    HorizontalLayout {
        y: root.chrome-height;
        height: root.height - root.chrome-height;
        Rectangle {
            horizontal-stretch: 1;
            home := HomePage {
                visible: root.page == Page.home;
                interactive: root.page == Page.home && !root.drawer-visible;
                // A resize can draw before deferred changed callbacks run.
                // Never expose a new rectangle using an old acknowledgement.
                map-preview-ready: root.map-preview-ready && root.map-preview-confirmed == root.map-viewport;
                map-preview-enabled: root.map-preview-enabled && root.page == Page.home && !root.drawer-visible;
                width: parent.width;
                height: parent.height;
                current-page <=> root.home-page;
                calendar-day: root.calendar-day;
                calendar-month: root.calendar-month;
                calendar-year: root.calendar-year;
                phone: root.phone;
                track-title: root.track-title;
                artist: root.artist;
                artwork: root.artwork;
                has-artwork: root.has-artwork;
                media-enabled: root.home-media-enabled;
                open(i) => { root.home-open(i); }
            }
            if root.page == Page.projection: ProjectionPage {
                width: parent.width;
                height: parent.height;
                streaming: root.phone == PhoneState.streaming;
                idle-icon: root.projection-icon;
                stream-width: root.stream-width;
                stream-height: root.stream-height;
                mask: root.main-mask;
                touch(phase, x, y) => { root.touch(phase, x, y); }
            }
            if root.page == Page.media: MediaPage {
                width: parent.width;
                height: parent.height;
                track-title: root.track-title;
                artist: root.artist;
                album: root.album;
                app: root.app;
                artwork: root.artwork;
                has-artwork: root.has-artwork;
                playing: root.playing;
                progress: root.progress;
                elapsed-ms: root.elapsed-ms;
                total-ms: root.total-ms;
                can-seek: root.can-seek;
                show-spectrum <=> root.show-spectrum;
                bands: root.bands;
                play-pause => { root.play-pause(); }
                prev => { root.prev(); }
                next => { root.next(); }
                seek(f) => { root.seek(f); }
                spectrum-changed(on) => { root.spectrum-changed(on); }
            }
            if root.page == Page.settings: SettingsView {
                width: parent.width;
                height: parent.height;
            }
            if root.page == Page.camera && !root.camera-found: Rectangle {
                background: Theme.background;
                Text {
                    text: root.no-camera;
                    color: Theme.text-secondary;
                    font-size: 20px;
                }
            }
            if root.status != "": Text {
                x: 16px;
                y: parent.height - 32px;
                text: root.status;
                color: #ff8a80;
                font-size: 14px;
            }
        }
    }

    // The native menu appears on demand; normal ID6 screens have no permanent rail.
    if root.drawer-visible: Nav {
        x: root.right-hand ? root.width - self.width : 0px;
        y: root.chrome-height;
        height: root.height - root.chrome-height;
        tabs: root.tabs;
        active: root.page;
        phone: root.phone;
        right-hand: root.right-hand;
        asleep: false;
        select(p) => {
            root.page = p;
            root.page-chosen(p);
            root.drawer-open = false;
            Focus.zone = FocusZone.none;
        }
    }

    LevelOverlay {
        window-width: root.width;
        x: (root.width - self.width) / 2;
        y: 16px;
    }
    PhoneOverlay {
        window-width: root.width;
        x: root.width - self.width - 16px;
        y: 16px;
    }
}

export component SecondaryWindow inherits Window {
    in property <bool> has-dashboard;
    in property <string> window-title;
    title: root.window-title;
    in property <string> empty-label: "No content on this screen";
    default-font-family: "Roboto";
    background: root.has-dashboard ? transparent : #000000;

    if root.has-dashboard: Dashboard {
        width: root.width;
        height: root.height;
    }
    if !root.has-dashboard: Text {
        text: root.empty-label;
        color: #ffffff73;
        font-size: 20px;
    }
}
