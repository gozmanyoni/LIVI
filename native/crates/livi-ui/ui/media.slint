import { Theme, Ui } from "theme.slint";
import { Focus } from "focus.slint";
import { MediaText, Press, RoundButton, Spectrum, SourceTabs } from "media_parts.slint";
import { DabPage, DabState, StationData } from "dab.slint";

export { MediaText, Press, DabState, StationData }


component Progress inherits Rectangle {
    in property <bool> focused;
    in property <float> progress;
    in property <bool> can-seek;
    in property <float> total-ms;
    in property <float> elapsed-ms;
    in property <length> bar-height;
    in property <length> touch-height;
    callback seek(float);

    property <bool> dragging;
    property <float> drag-share;
    property <float> shown: dragging ? drag-share : progress;
    property <float> shown-ms: shown * total-ms;
    property <length> knob-h: min(touch-height - 12px, 28px);
    property <length> knob-w: 12px;
    property <length> time-font: clamp(touch-height * 0.37, 16px, 24px);

    pure function clock(ms: float) -> string {
        let s = floor(max(ms, 0) / 1000);
        let m = floor(s / 60);
        let r = mod(s, 60);
        return m + ":" + (r < 10 ? "0" : "") + r;
    }

    // The full band accepts scrubbing; the visible line stays deliberately thin.
    height: touch-height;
    HorizontalLayout {
        spacing: 12px;
        Text {
            min-width: root.time-font * 3.5;
            text: root.clock(root.dragging ? root.shown-ms : root.elapsed-ms);
            color: Theme.text.with-alpha(0.85);
            font-size: root.time-font;
            vertical-alignment: center;
        }
        track := Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - root.bar-height) / 2;
                height: root.bar-height;
                border-radius: 0px;
                clip: true;
                background: root.focused ? Theme.text-secondary : Theme.track;
                drop-shadow-blur: 0px;
                drop-shadow-color: Theme.highlight.with-alpha(0.35);
                Rectangle {
                    x: 0;
                    width: parent.width * root.shown;
                    background: Theme.highlight;
                }
            }
            if root.can-seek: Rectangle {
                width: root.knob-w;
                height: root.knob-h;
                y: (parent.height - self.height) / 2;
                x: clamp(parent.width * root.shown - self.width / 2, 0, parent.width - self.width);
                border-radius: 0px;
                background: Theme.highlight;
                drop-shadow-blur: 4px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000059;
            }
            TouchArea {
                enabled: root.can-seek && root.total-ms > 0;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.dragging = true;
                        root.drag-share = clamp(self.mouse-x / self.width, 0, 1);
                    } else if (e.kind == PointerEventKind.up && root.dragging) {
                        root.dragging = false;
                        root.seek(clamp(self.mouse-x / self.width, 0, 1));
                    } else if (e.kind == PointerEventKind.cancel) {
                        root.dragging = false;
                    }
                }
                moved => {
                    if (root.dragging) {
                        root.drag-share = clamp(self.mouse-x / self.width, 0, 1);
                    }
                }
            }
        }
        Text {
            min-width: root.time-font * 3.5;
            text: "-" + root.clock(root.total-ms - (root.dragging ? root.shown-ms : root.elapsed-ms));
            color: Theme.text.with-alpha(0.85);
            font-size: root.time-font;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component PhonePlayer inherits Rectangle {
    in property <int> focus-base;
    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    out property <bool> art-shown: two-col;
    property <int> off: focus-base + (two-col ? 1 : 0);

    init => { Focus.media-art = root.art-shown; }
    changed art-shown => { Focus.media-art = root.art-shown; }

    pure function clampf(v: float, lo: float, hi: float) -> float { return min(max(v, lo), hi); }

    property <float> w: root.width / 1px;
    property <float> h: root.height / 1px;
    property <float> min-side: min(w, h);
    property <bool> tiny: h > 0 && h <= 320;
    property <float> text-scale: tiny ? 0.88 : 1;

    property <float> page-pad-raw: round(clampf(min-side * 0.055, 12, 30));
    property <float> page-pad: tiny ? min(page-pad-raw, 10) : page-pad-raw;
    property <float> col-gap: round(clampf(w * 0.045, 20, 64));
    property <float> ctrl-size: min(round(clampf(h * 0.22, 56, 96)), floor((w - page-pad * 2 - ctrl-gap * 2) / 3.125));
    property <float> play-size: round(ctrl-size * 1.125);
    property <float> seek-size: round(clampf(h * 0.14, 42, 68));
    property <float> ctrl-gap: round(clampf(w * 0.02, 12, 32));
    property <float> progress-h-raw: round(clampf(h * 0.008, 4, 6));
    property <float> progress-h: max(4, round(progress-h-raw * (tiny ? 0.85 : 1)));

    property <float> title-px: max(12, round(round(clampf(min-side * 0.07, 18, 48)) * text-scale));
    property <float> artist-px: max(11, round(22 * Ui.nbt-scale));
    property <float> album-px: max(10, round(20 * Ui.nbt-scale));
    property <float> app-px: max(9, round(16 * Ui.nbt-scale));

    property <float> bottom-dock-h: play-size + seek-size + (tiny ? 6 : 16);
    property <float> content-h: max(0, h - page-pad * 2 - bottom-dock-h);
    property <float> inner-w: max(0, w - page-pad * 2);
    property <bool> two-col: inner-w >= 120 + 100 + col-gap && content-h >= 72;
    property <float> art-allowance: max(0, floor(inner-w - 120 - col-gap));
    property <float> art-px: round(clampf(min(content-h, art-allowance), 0, 520));
    property <float> text-side-pad: max(6, round(page-pad * 0.75));

    VerticalLayout {
        padding-top: root.page-pad * 1px;
        padding-left: root.page-pad * 1px;
        padding-right: root.page-pad * 1px;
        padding-bottom: (root.tiny ? 2 : root.page-pad) * 1px;
        spacing: (root.tiny ? 3 : 4) * 1px;

        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: root.col-gap * 1px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    min-width: 120px;
                    padding-left: root.text-side-pad * 1px;
                    padding-right: root.two-col ? 0 : root.text-side-pad * 1px;
                    Text {
                        text: root.track-title;
                        color: Theme.text;
                        font-size: root.title-px * 1px;
                        font-weight: 300;
                        letter-spacing: 0.2px;
                        overflow: elide;
                    }
                    if root.two-col: Text {
                        text: root.artist;
                        color: Theme.text.with-alpha(0.9);
                        font-size: root.artist-px * 1px;
                        overflow: elide;
                    }
                    if root.two-col: Text {
                        text: root.album;
                        color: Theme.text.with-alpha(0.7);
                        font-size: root.album-px * 1px;
                        overflow: elide;
                    }
                    Text {
                        text: root.two-col ? root.app : root.artist;
                        color: Theme.text.with-alpha(0.55);
                        font-size: root.app-px * 1px;
                        overflow: elide;
                    }
                }
                if root.two-col: Rectangle {
                    width: root.art-px * 1px;
                    Rectangle {
                        width: root.art-px * 1px;
                        height: root.art-px * 1px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 0px;
                        border-width: Focus.main(root.focus-base) ? 2px : 1px;
                        border-color: Focus.main(root.focus-base) ? Theme.selection-edge : #8b8b8b;
                        clip: true;
                        background: Theme.panel;
                        drop-shadow-blur: 18px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: #000000a0;
                        if !root.show-spectrum && root.has-artwork: Image {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            source: root.artwork;
                            image-fit: cover;
                        }
                        if !root.show-spectrum && !root.has-artwork: Image {
                            width: parent.width * 0.35;
                            height: self.width;
                            source: @image-url("assets/id6-note.svg");
                        }
                        if root.show-spectrum: Spectrum {
                            x: max(8, round(root.art-px * 0.06)) * 1px;
                            y: self.x + (parent.height - 2 * self.x) * 0.075;
                            width: parent.width - 2 * self.x;
                            height: (parent.height - 2 * self.x) * 0.85;
                            bands: root.bands;
                        }
                        TouchArea {
                            clicked => {
                                root.show-spectrum = !root.show-spectrum;
                                root.spectrum-changed(root.show-spectrum);
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: (root.tiny ? 3 : 4) * 1px;
            padding-bottom: root.tiny ? 0 : 8px;
            HorizontalLayout {
                alignment: center;
                spacing: root.ctrl-gap * 1px;
                RoundButton {
                    focused: Focus.main(root.off);
                    flash: Press.prev;
                    size: root.ctrl-size * 1px;
                    icon-size: round(root.ctrl-size * 0.50) * 1px;
                    icon: @image-url("icons/SkipPrevious.svg");
                    clicked => { root.prev(); }
                }
                RoundButton {
                    focused: Focus.main(root.off + 1);
                    flash: Press.play;
                    size: root.play-size * 1px;
                    icon-size: round(root.play-size * 0.50) * 1px;
                    icon: root.playing ? @image-url("icons/Pause.svg") : @image-url("icons/PlayArrow.svg");
                    clicked => { root.play-pause(); }
                }
                RoundButton {
                    focused: Focus.main(root.off + 2);
                    flash: Press.next;
                    size: root.ctrl-size * 1px;
                    icon-size: round(root.ctrl-size * 0.50) * 1px;
                    icon: @image-url("icons/SkipNext.svg");
                    clicked => { root.next(); }
                }
            }
            Progress {
                focused: root.can-seek && Focus.main(root.off + 3);
                progress: root.progress;
                can-seek: root.can-seek;
                total-ms: root.total-ms;
                elapsed-ms: root.elapsed-ms;
                bar-height: root.progress-h * 1px;
                touch-height: root.seek-size * 1px;
                seek(f) => { root.seek(f); }
            }
        }
    }
}

export component MediaPage inherits Rectangle {
    in property <string> track-title;
    in property <string> artist;
    in property <string> album;
    in property <string> app;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <float> elapsed-ms;
    in property <float> total-ms;
    in property <bool> can-seek;
    in-out property <bool> show-spectrum;
    in property <[float]> bands;
    callback play-pause();
    callback prev();
    callback next();
    callback seek(float);
    callback spectrum-changed(bool);

    property <int> base: DabState.receiver ? 2 : 0;
    property <bool> dab-shown: DabState.receiver && DabState.view-dab;
    property <bool> stacked-sources: DabState.receiver && root.width < 600px;
    property <length> source-h: root.height < 300px ? 48px : 64px;
    property <length> heading-h: (root.height < 300px ? 52px : 80px) + (root.stacked-sources ? root.source-h : 0px);
    property <length> tabs-h: root.heading-h;

    background: Theme.backdrop;

    Rectangle {
        y: 0px;
        height: root.heading-h;
        Text {
            x: 28px;
            text: "Media/Radio";
            color: Theme.text;
            font-size: root.height < 300px ? 20px : 32px;
            font-weight: 300;
            height: root.heading-h - (root.stacked-sources ? root.source-h : 0px);
            vertical-alignment: center;
        }
        if DabState.receiver: SourceTabs {
            x: root.stacked-sources ? 20px : parent.width - self.width - 28px;
            y: root.stacked-sources ? parent.height - self.height : (parent.height - self.height) / 2;
            width: min(400px, parent.width - (root.stacked-sources ? 40px : 280px));
            height: root.source-h;
            dab-active: DabState.view-dab;
            focus-base: 0;
            phone => { DabState.phone(); }
            dab => { DabState.resume(); }
        }
        Rectangle {
            x: 28px;
            y: parent.height - 1px;
            width: parent.width - 56px;
            height: 1px;
            background: @linear-gradient(90deg, #ffffff80 0%, #77777760 70%, transparent 100%);
        }
    }
    Rectangle {
        if !root.dab-shown: PhonePlayer {
            y: root.tabs-h;
            width: parent.width;
            height: parent.height - root.tabs-h;
            focus-base: root.base;
            track-title: root.track-title;
            artist: root.artist;
            album: root.album;
            app: root.app;
            artwork: root.artwork;
            has-artwork: root.has-artwork;
            playing: root.playing;
            progress: root.progress;
            elapsed-ms: root.elapsed-ms;
            total-ms: root.total-ms;
            can-seek: root.can-seek;
            show-spectrum <=> root.show-spectrum;
            bands: root.bands;
            play-pause => { root.play-pause(); }
            prev => { root.prev(); }
            next => { root.next(); }
            seek(f) => { root.seek(f); }
            spectrum-changed(on) => { root.spectrum-changed(on); }
        }
        if root.dab-shown: DabPage {
            y: root.tabs-h;
            width: parent.width;
            height: parent.height - root.tabs-h;
            focus-base: root.base;
            show-spectrum <=> root.show-spectrum;
            bands: root.bands;
            spectrum-changed(on) => { root.spectrum-changed(on); }
            play-pause => { root.play-pause(); }
            prev => { root.prev(); }
            next => { root.next(); }
        }
    }
}
