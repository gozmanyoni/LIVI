import { Theme } from "theme.slint";
import { ViewAreaMask, MaskData } from "mask.slint";

export enum TouchPhase { down, move, up, cancel }

export component ProjectionPage inherits Rectangle {
    in property <int> stream-width: 1280;
    in property <int> stream-height: 720;
    in property <bool> streaming;
    in property <MaskData> mask;
    in property <image> idle-icon;
    callback touch(TouchPhase, float, float);

    background: root.streaming ? transparent : Theme.background;

    Rectangle {
        width: min(root.width, root.height * root.stream-width / root.stream-height);
        height: min(root.height, root.width * root.stream-height / root.stream-width);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        TouchArea {
            enabled: root.streaming;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.touch(TouchPhase.down, self.mouse-x / self.width, self.mouse-y / self.height);
                } else if (e.kind == PointerEventKind.up) {
                    root.touch(TouchPhase.up, self.mouse-x / self.width, self.mouse-y / self.height);
                } else if (e.kind == PointerEventKind.cancel) {
                    root.touch(TouchPhase.cancel, self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
            moved => {
                if (self.pressed) {
                    root.touch(TouchPhase.move, self.mouse-x / self.width, self.mouse-y / self.height);
                }
            }
        }
    }

    if root.streaming: ViewAreaMask {
        mask: root.mask;
    }

    if !root.streaming: VerticalLayout {
        alignment: center;
        spacing: root.height < 300px ? 10px : 22px;
        Rectangle {
            height: min(root.width, root.height) * 0.17;
            Image {
                x: (parent.width - self.width) / 2;
                source: root.idle-icon;
                width: parent.height;
                height: self.width;
                colorize: Theme.primary;
            }
        }
        Text {
            text: "Connect a phone to begin";
            color: Theme.text;
            font-size: root.height < 300px ? 20px : 30px;
            font-weight: 300;
            horizontal-alignment: center;
        }
        Text {
            text: "Manage mobile devices in Communication";
            color: Theme.text-secondary;
            font-size: root.height < 300px ? 13px : 18px;
            horizontal-alignment: center;
        }
    }
}
