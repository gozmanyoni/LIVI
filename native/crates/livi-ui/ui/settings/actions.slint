import { Theme } from "../theme.slint";
import { Metrics } from "metrics.slint";

export component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> outlined;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();

    property <bool> lit: touch.has-hover || touch.pressed || root.focused;

    width: max(140px, label.preferred-width + 48px);
    height: max(44px, Metrics.touch-size - 8px);
    border-radius: 0px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.lit ? Theme.selection : Theme.panel;
    border-width: 1px;
    border-color: root.lit ? Theme.selection-edge : #555555;
    drop-shadow-blur: 0;
    drop-shadow-color: Theme.highlight.with-alpha(0.55);
    Rectangle {
        border-radius: 0px;
        border-width: 0;
        border-color: Theme.highlight.with-alpha(root.focused ? 0.85 : 0.65);
    }
    label := Text {
        text: root.text;
        font-size: max(16px, Metrics.row-font * 0.85);
        font-weight: 400;
        letter-spacing: 0.4px;
        color: root.lit ? #ffffff : Theme.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();

    property <length> glyph: max(Metrics.icon-px, Metrics.touch-size * 0.42);
    width: Metrics.touch-size;
    height: Metrics.touch-size;
    border-radius: 0px;
    opacity: root.enabled ? 1 : 0.38;
    background: root.focused || (touch.has-hover && root.enabled) ? Theme.selection : transparent;
    border-width: root.focused ? 2px : 0;
    border-color: Theme.primary;
    Image {
        width: root.glyph;
        height: root.glyph;
        source: root.icon;
        colorize: root.focused || (touch.has-hover && root.enabled) ? #ffffff : root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
