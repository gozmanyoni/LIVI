import { Theme } from "../theme.slint";
import { Metrics } from "metrics.slint";

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    width: Metrics.touch-size;
    height: Metrics.touch-size;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: clamp(Metrics.touch-size * 0.45, 24px, 34px);
        height: self.width;
        border-width: 1px;
        border-color: #a0a0a0;
        background: @linear-gradient(180deg, #070707, #292929);
        if root.checked: Text {
            text: "✓";
            color: #ffffff;
            font-size: parent.height;
            font-weight: 400;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

export global SliderGrab {
    in-out property <bool> held;
}

export component Slider inherits Rectangle {
    in property <float> level;
    in property <bool> enabled: true;
    in property <bool> focused;
    in property <color> tint: Theme.primary;
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> small;
    callback moved(float);
    callback released(float);

    property <bool> dragging;
    property <float> drag-level;
    property <float> shown: dragging ? drag-level : level;
    property <length> pill: root.small ? Metrics.pill-h-small : Metrics.pill-h;
    property <length> fill: self.width * clamp(root.shown, 0, 1);
    property <bool> lit: root.focused || root.dragging || touch.has-hover;

    min-height: root.pill;
    horizontal-stretch: 1;

    Rectangle {
        y: parent.height - 6px;
        height: 6px;
        border-radius: 0px;
        background: Theme.track;
        border-width: root.lit ? 1px : 0px;
        border-color: Theme.text;
    }
    Rectangle {
        x: 0;
        y: parent.height - 6px;
        width: root.fill;
        height: 6px;
        border-radius: 0px;
        background: root.tint;
    }
    if root.has-icon: Image {
        x: root.pill * 0.4;
        y: (parent.height - self.height) / 2;
        width: root.pill * 0.5;
        height: root.pill * 0.5;
        source: root.icon;
        colorize: #ffffff;
    }
    label := Text {
        x: root.has-icon ? root.pill : 0px;
        y: 0px;
        text: root.text;
        font-size: root.small ? Metrics.pill-font-small : Metrics.pill-font;
        font-weight: 400;
        color: Theme.text;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.dragging = true;
                SliderGrab.held = true;
                root.drag-level = clamp(self.mouse-x / self.width, 0, 1);
                root.moved(root.drag-level);
            } else if (e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                SliderGrab.held = false;
                root.released(clamp(self.mouse-x / self.width, 0, 1));
            } else if (e.kind == PointerEventKind.cancel) {
                root.dragging = false;
                SliderGrab.held = false;
            }
        }
        moved => {
            if (root.dragging) {
                root.drag-level = clamp(self.mouse-x / self.width, 0, 1);
                root.moved(root.drag-level);
            }
        }
    }
}
