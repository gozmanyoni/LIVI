export global Theme {
    in property <bool> dark: true;
    in property <color> primary-override: transparent;
    in property <color> highlight-override: transparent;
    in property <color> background-override: transparent;
    in property <color> text-override: transparent;

    out property <color> background: background-override.alpha > 0 ? background-override : (dark ? #050506 : #ecebea);
    out property <color> paper: dark ? #151517 : #ffffff;
    out property <color> text: text-override.alpha > 0 ? text-override : (dark ? #f3f1ed : #111111);
    out property <color> text-secondary: text.with-alpha(dark ? 0.84 : 0.8);
    out property <color> text-disabled: text.with-alpha(dark ? 0.5 : 0.38);
    out property <color> primary: primary-override.alpha > 0 ? primary-override : (dark ? #ed6628 : #ae441d);
    out property <color> highlight: highlight-override.alpha > 0 ? highlight-override : (dark ? #ed6628 : #ae441d);
    out property <color> divider: dark ? #a7abb24a : #0000001f;
    out property <color> selection-edge: #ffb45e;
    out property <brush> selection: @linear-gradient(180deg, #a95d48, #50131b 8%, #30070e 44%, #650b18 85%, #be1c2a 97%, #e14a36);
    out property <brush> panel: dark ? @linear-gradient(180deg, #242428, #121216 32%, #37383e 65%, #0b0b0e 84%, #18191c) : @linear-gradient(180deg, #ffffff, #d9d9dc);
    out property <brush> backdrop: dark ? @linear-gradient(180deg, #050506, #09090b 42%, #202127 65%, #070709 77%, #020203) : @linear-gradient(180deg, #eeeeee, #d4d4d8);
    out property <color> surface: dark ? #ffffff0f : #0000000f;
    out property <color> button: #ffffff29;
    out property <color> button-active: #ffffff3d;
    out property <color> track: #ffffff47;
}

export global Ui {
    in property <length> width: 1280px;
    in property <length> height: 720px;
    out property <float> nbt-scale: max(0.45, min(width / 1600px, height / 600px));
    out property <bool> xs-icons: height <= 320px;
    out property <bool> show-clock: height > 220px;
    out property <length> icon-size: xs-icons ? 28px : 40px;
    out property <length> nav-width: xs-icons ? 56px : 88px;
    out property <length> nav-pad: 7px;
}
